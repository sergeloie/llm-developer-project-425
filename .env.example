# === YDB ===
YDB_ENDPOINT=grpcs://ydb.serverless.yandexcloud.net:2135
YDB_DATABASE=/ru-central1/...
# YDB_TOKEN не используется: аутентификация YDB идёт через IAM сервисного аккаунта ai-studio-sa
# (YdbTransportFactory → CloudAuthHelper.getAuthProviderFromEnviron() → metadata service).
# Переменная оставлена для совместимости, если вы используете AccessTokenCredentials вручную.
# YDB_TOKEN=

# === ydb-tickets (email-poller → append-message, п.7 ревью) ===
# YdbMessageSaver (роль=agent строка с токенами) ходит в ydb-tickets по HTTP.
# 1) YDB_TICKETS_URL — полный URL функции ydb-tickets (https://functions.yandexcloud.net/<function_id>).
# 2) YDB_TICKETS_FUNCTION_ID — ID функции; используется как fallback, если URL не задан.
# Обе передаются в `--environment` скриптом deploy-email-poller.ps1.
YDB_TICKETS_URL=https://functions.yandexcloud.net/d4e3gutmcpvrpruro2cb
YDB_TICKETS_FUNCTION_ID=d4e3gutmcpvrpruro2cb

# === Yandex Cloud ===
YC_FOLDER_ID=b1g...
FOLDER_ID=b1g...  # алиас YC_FOLDER_ID для InjectionClassifier (yandexgpt-lite)

# === Agent / AI Studio ===
AGENT_ID=fvtu3g417klcgdhf6fih
ORGANIZATION_ID=b1gvnmb6q5tj79tmk27j
YANDEX_API_KEY=... # Lockbox: agent-api-key (key=password)
MCP_SERVER_URL=https://...mcpgw.serverless.yandexcloud.net/sse
VECTOR_STORE_ID=fvtn72d9ke0vulslnq37

# === Mail (IMAP/SMTP) ===
IMAP_HOST=imap.yandex.ru
IMAP_USER=anser.74@yandex.ru
IMAP_PASSWORD=...  # Lockbox: email-credentials (key=password) — один секрет на IMAP и SMTP
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=anser.74@yandex.ru
SMTP_PASSWORD=...  # Lockbox: email-credentials (key=password) — тот же секрет, что и IMAP_PASSWORD
HELPDESK_MAILBOX=anser.74@yandex.ru
OPERATOR_EMAIL=anser.74@yandex.ru  # алиас HELPDESK_MAILBOX для YaWL workflow (email-sender поддерживает оба)
# SMTP_DEBUG=false  # true → включает Session debug (SmtpEmailSender)
